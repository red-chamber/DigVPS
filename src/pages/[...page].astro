---
import { getEntry, render } from "astro:content";
import Markdown from "../components/misc/Markdown.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";

export function getStaticPaths() {
	return [{ params: { page: undefined } }];
}

const homeGuide = await getEntry("spec", "home");

if (!homeGuide) {
	throw new Error("Home guide content not found");
}

const { Content } = await render(homeGuide);
---

<MainGridLayout title="Entry Protocol" description="A guide to Cedrian Ian's archive.">
    <article class="card-base w-full rounded-[var(--radius-large)] px-6 py-8 md:px-9 md:py-9">
        <Markdown class="markdown-content onload-animation">
            <Content />
        </Markdown>
    </article>
</MainGridLayout>
