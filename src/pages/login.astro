---
import AuthLayout from "../layouts/AuthLayout.astro";
---

<AuthLayout title="Sign In" description="Sign in to Cedrian Ian">
	<header class="mb-7">
		<h1 class="font-serif text-3xl font-bold text-black/85">Sign In</h1>
		<p class="mt-2 text-sm text-black/50">Your session will remain active on this device for 3 days.</p>
	</header>

	<form id="login-form" class="space-y-5">
		<label class="block">
			<span class="mb-2 block text-sm font-medium text-black/70">Email</span>
			<input
				id="login-email"
				name="email"
				type="text"
				inputmode="email"
				autocomplete="username"
				required
				class="auth-input"
				placeholder="name@example.com"
			/>
		</label>
		<label class="block">
			<span class="mb-2 block text-sm font-medium text-black/70">Password</span>
			<input
				id="login-password"
				name="password"
				type="password"
				autocomplete="current-password"
				required
				class="auth-input"
				placeholder="Enter your password"
			/>
		</label>

		<p id="login-message" class="auth-message hidden" role="alert"></p>
		<button id="login-submit" type="submit" class="auth-submit">Sign In</button>
	</form>

	<button id="guest-entry" type="button" class="mt-4 flex w-full items-center justify-center rounded-lg border border-[var(--primary)]/30 bg-white/40 px-4 py-3 font-bold text-[var(--primary)] transition hover:bg-white/60">Continue as Guest</button>
	<p class="mt-2 text-center text-xs text-black/50">Browse published content. Sign in to like, comment, or submit notes.</p>

	<p class="mt-6 text-center text-sm text-black/50">
		No account yet?
		<a href="/register/" data-astro-reload class="font-medium text-[var(--primary)] hover:underline">Register</a>
	</p>
</AuthLayout>

<style>
	.auth-input {
		@apply w-full rounded-lg px-4 py-3 text-black/80 outline-none transition placeholder:text-black/35;
		border: 1px solid oklch(0.58 0.055 190 / 0.42);
		background: oklch(0.985 0.012 190 / 0.78);
		box-shadow: inset 0 1px 2px oklch(0.25 0.03 190 / 0.07);
	}
	.auth-input:focus {
		border-color: oklch(0.5 0.12 195);
		box-shadow: 0 0 0 3px oklch(0.66 0.12 195 / 0.24);
	}
	.auth-submit {
		display: flex;
		min-height: 3.25rem;
		width: 100%;
		align-items: center;
		justify-content: center;
		border: 1px solid oklch(0.38 0.11 195);
		border-radius: 0.65rem;
		background: linear-gradient(135deg, oklch(0.51 0.13 195), oklch(0.47 0.12 170));
		box-shadow: 0 10px 24px oklch(0.34 0.09 190 / 0.25);
		color: white;
		font-weight: 700;
		letter-spacing: 0.04em;
		transition: transform 150ms ease, box-shadow 150ms ease, filter 150ms ease;
	}
	.auth-submit:hover {
		filter: brightness(1.08);
		transform: translateY(-1px);
		box-shadow: 0 13px 28px oklch(0.34 0.09 190 / 0.3);
	}
	.auth-submit:active {
		transform: translateY(0) scale(0.99);
	}
	.auth-submit:focus-visible {
		outline: 3px solid oklch(0.68 0.12 195 / 0.42);
		outline-offset: 2px;
	}
	.auth-submit:disabled {
		cursor: wait;
		opacity: 0.66;
	}
	.auth-message {
		@apply rounded-lg border px-4 py-3 text-sm;
	}
	.auth-message[data-kind="error"] {
		@apply border-red-200 bg-red-50 text-red-700;
	}
</style>

<script>
	function destinationAfterLogin() {
		const next = new URL(window.location.href).searchParams.get("next");
		return next?.startsWith("/") && !next.startsWith("//") ? next : "/";
	}

	const form = document.querySelector<HTMLFormElement>("#login-form");
	const email = document.querySelector<HTMLInputElement>("#login-email");
	const password = document.querySelector<HTMLInputElement>("#login-password");
	const message = document.querySelector<HTMLParagraphElement>("#login-message");
	const submit = document.querySelector<HTMLButtonElement>("#login-submit");
	const guest = document.querySelector<HTMLButtonElement>("#guest-entry");
	guest?.addEventListener("click", async () => {
		guest.disabled = true;
		message?.classList.add("hidden");
		try {
			const response = await fetch("/api/auth/guest", { method: "POST" });
			const result = await response.json();
			if (!response.ok) throw new Error(result.error || "Guest access is unavailable.");
			window.location.assign("/");
		} catch (error) {
			if (message) {
				message.textContent = error instanceof Error ? error.message : "Guest access is unavailable.";
				message.dataset.kind = "error";
				message.classList.remove("hidden");
			}
		} finally {
			guest.disabled = false;
		}
	});

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!email || !password || !message || !submit) return;
		submit.disabled = true;
		submit.textContent = "Signing in…";
		message.classList.add("hidden");
		try {
			const response = await fetch("/api/auth/login", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ email: email.value, password: password.value }),
			});
			const result = await response.json();
			if (!response.ok) throw new Error(result.error || "Sign-in failed.");
			window.location.assign(destinationAfterLogin());
		} catch (error) {
			message.textContent =
				error instanceof Error ? error.message : "Sign-in failed. Please try again later.";
			message.dataset.kind = "error";
			message.classList.remove("hidden");
		} finally {
			submit.disabled = false;
			submit.textContent = "Sign In";
		}
	});
</script>
