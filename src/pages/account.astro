---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="账户" description="管理当前 RC Domain 登录会话">
	<section id="account-page" class="card-base px-6 py-7 md:px-9 md:py-8">
		<div class="mb-6 flex items-center gap-3">
			<div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--btn-regular-bg)] text-[var(--primary)]">
				<Icon name="fa6-regular:user" class="text-[1.45rem]" />
			</div>
			<div>
				<h1 class="font-serif text-3xl font-bold text-black/90">账户</h1>
				<p class="mt-1 text-black/50">当前设备的登录信息</p>
			</div>
		</div>

		<div id="account-loading" class="rounded-lg bg-[var(--btn-regular-bg)] px-4 py-4 text-black/55">正在读取账户信息……</div>
		<div id="account-details" class="hidden space-y-4">
			<dl class="divide-y divide-[var(--line-divider)] rounded-lg border border-[var(--line-color)] bg-white/50 px-5">
				<div class="flex flex-col gap-1 py-4 sm:flex-row sm:items-center sm:justify-between">
					<dt class="text-sm text-black/45">邮箱</dt>
					<dd id="account-email" class="font-medium text-black/75"></dd>
				</div>
				<div class="flex flex-col gap-1 py-4 sm:flex-row sm:items-center sm:justify-between">
					<dt class="text-sm text-black/45">角色</dt>
					<dd id="account-role" class="font-medium text-black/75"></dd>
				</div>
				<div class="flex flex-col gap-1 py-4 sm:flex-row sm:items-center sm:justify-between">
					<dt class="text-sm text-black/45">登录有效期</dt>
					<dd id="account-expiry" class="font-medium text-black/75"></dd>
				</div>
			</dl>
			<p id="account-message" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"></p>
			<button id="logout-button" type="button" class="btn-regular w-full rounded-lg px-4 py-3 font-bold">退出登录</button>
		</div>
	</section>
</MainGridLayout>
