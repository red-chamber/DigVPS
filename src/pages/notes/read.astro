---
import NoteInteractions from "@components/NoteInteractions.astro";
import NoteTableOfContents from "@components/NoteTableOfContents.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
---

<MainGridLayout title="Read Note" description="Markdown notes published by the administrator">
	<div id="dynamic-note-loading" class="card-base mb-4 px-6 py-7 text-black/55 md:px-9">Loading note…</div>
	<article id="dynamic-note" class="card-base mb-4 hidden px-6 py-7 md:px-9 md:py-8">
		<p id="dynamic-note-category" class="text-sm font-medium text-[var(--primary)]"></p>
		<h1 id="dynamic-note-title" class="mt-1 font-serif text-3xl font-bold text-black/90"></h1>
		<p id="dynamic-note-description" class="mt-3 text-black/55"></p>
		<div id="dynamic-note-meta" class="mt-3 text-sm text-black/40"></div>
		<div class="my-5 border-b border-dashed border-[var(--line-divider)]"></div>
		<div id="dynamic-note-content" class="prose custom-md markdown-content !max-w-none"></div>
	</article>
	<section id="related-notes" class="card-base mb-4 hidden px-6 py-6 md:px-9">
		<h2 class="font-serif text-2xl font-bold text-black/90">Related Notes</h2>
		<div id="related-notes-list" class="mt-4 grid gap-3 md:grid-cols-2"></div>
	</section>
	<div id="dynamic-note-interactions" class="hidden">
		<NoteInteractions noteKey="" />
	</div>
	<NoteTableOfContents slot="overlay" />
</MainGridLayout>

<style is:global>
	#dynamic-note-content :not(pre) > code {
		border-radius: 0.35rem;
		background: var(--inline-code-bg);
		color: var(--inline-code-color);
		padding: 0.12rem 0.35rem;
		font-family: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
		font-size: 0.875em;
	}

	#dynamic-note-content .dynamic-code-block {
		margin: 1.25rem 0;
		overflow: hidden;
		border: 1px solid rgba(92, 132, 150, 0.2);
		border-radius: 0.75rem;
		background: rgba(238, 247, 249, 0.78);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);
	}

	#dynamic-note-content .dynamic-code-toolbar {
		display: flex;
		min-height: 2.6rem;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px solid rgba(92, 132, 150, 0.16);
		background: rgba(218, 235, 240, 0.58);
		padding: 0.4rem 0.55rem 0.4rem 1rem;
	}

	#dynamic-note-content .dynamic-code-language {
		color: rgba(28, 54, 63, 0.55);
		font-family: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	#dynamic-note-content .dynamic-code-copy {
		border: 1px solid rgba(77, 119, 136, 0.18);
		border-radius: 0.5rem;
		background: rgba(255, 255, 255, 0.62);
		color: rgba(22, 55, 68, 0.72);
		padding: 0.4rem 0.7rem;
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1;
		cursor: pointer;
		transition: background-color 150ms ease, color 150ms ease, transform 150ms ease;
	}

	#dynamic-note-content .dynamic-code-copy:hover {
		background: rgba(255, 255, 255, 0.92);
		color: var(--primary);
	}

	#dynamic-note-content .dynamic-code-copy:active {
		transform: scale(0.95);
	}

	#dynamic-note-content .dynamic-code-copy.success {
		background: rgba(195, 238, 225, 0.86);
		color: rgb(22, 103, 81);
	}

	#dynamic-note-content .dynamic-code-block pre {
		margin: 0 !important;
		border: 0;
		border-radius: 0;
		background: transparent !important;
		padding: 1rem 1.15rem !important;
		color: rgb(35, 52, 59) !important;
		box-shadow: none;
		overflow-x: auto;
	}

	#dynamic-note-content .dynamic-code-block pre > code {
		display: block;
		border: 0;
		border-radius: 0;
		background: transparent !important;
		padding: 0 !important;
		color: inherit !important;
		font-family: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
		font-size: 0.875rem;
		font-weight: 400;
		line-height: 1.65;
		text-shadow: none;
	}

	#dynamic-note-content :is(.hljs-keyword, .hljs-type) {
		color: #a626a4;
	}

	#dynamic-note-content :is(.hljs-title, .hljs-built_in) {
		color: #4078f2;
	}

	#dynamic-note-content :is(.hljs-string, .hljs-meta .hljs-string) {
		color: #50a14f;
	}

	#dynamic-note-content :is(.hljs-number, .hljs-literal, .hljs-symbol, .hljs-meta) {
		color: #986801;
	}

	#dynamic-note-content .hljs-comment {
		color: #6a737d;
		font-style: italic;
	}

	#dynamic-note-content .dynamic-code-block pre > code::before,
	#dynamic-note-content .dynamic-code-block pre > code::after {
		content: none;
	}
</style>
