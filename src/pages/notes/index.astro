---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="Learning Notes" description="Computer science notes and practical records">
	<div class="card-base px-6 py-7 md:px-9 md:py-8 mb-4 onload-animation">
		<div class="flex items-center gap-3 mb-3">
			<div class="h-11 w-11 rounded-lg bg-[var(--btn-regular-bg)] text-[var(--primary)] flex items-center justify-center">
				<Icon name="material-symbols:library-books-outline-rounded" class="text-[1.75rem]" />
			</div>
			<div>
				<h1 class="font-serif font-bold text-3xl text-black/90 dark:text-white/90">Learning Notes</h1>
				<p class="text-black/50 dark:text-white/50 mt-1">Organized by field · <span id="notes-total-count">0 notes</span></p>
			</div>
		</div>
		<nav id="notes-category-nav" aria-label="Note categories" class="flex flex-wrap gap-2 mt-5"></nav>
		<div id="notes-active-filter" class="mt-5 hidden items-center justify-between gap-3 rounded-lg border border-[var(--line-color)] bg-white/40 px-4 py-3 text-sm text-black/60">
			<span id="notes-active-filter-label"></span>
			<a href="/notes/" class="shrink-0 font-bold text-[var(--primary)] hover:underline">Show all notes</a>
		</div>
	</div>

	<div id="notes-list"></div>
	<p id="notes-empty-filter" class="card-base mb-4 hidden px-6 py-5 text-center text-black/50">No notes match this filter.</p>
	<p id="dynamic-notes-error" class="card-base mb-4 hidden px-6 py-5 text-red-700"></p>
</MainGridLayout>
