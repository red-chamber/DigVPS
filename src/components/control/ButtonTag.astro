---
interface Props {
	size?: string;
	dot?: boolean;
	href?: string;
	label?: string;
	dataValue?: string;
	staticCount?: number;
}
const { dot, href, label, dataValue, staticCount }: Props = Astro.props;
---
<a href={href} aria-label={label} data-tag-name={dataValue} data-static-count={staticCount} class="btn-regular h-8 text-sm px-3 rounded-lg">
    {dot && <div class="h-1 w-1 bg-[var(--btn-content)] dark:bg-[var(--card-bg)] transition rounded-md mr-2"></div>}
    <slot></slot>
</a>
