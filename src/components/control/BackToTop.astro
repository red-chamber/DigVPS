---
import { Icon } from "astro-icon/components";
---

<button id="back-to-top-btn" aria-label="返回页面顶部" title="返回顶部"
        class="back-to-top-btn hide btn-card rounded-full shadow-lg backdrop-blur-md">
    <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
</button>

<style lang="stylus">
.back-to-top-btn
    color: var(--primary)
    position: fixed
    right: 1.25rem
    bottom: 1.25rem
    z-index: 60
    width: 3.25rem
    height: 3.25rem
    font-size: 2rem
    border: 1px solid var(--line-color)
    opacity: 1
    cursor: pointer
    transform: translateY(0) scale(1)
    i
        font-size: 1.75rem
    &.hide
        transform: translateY(1rem) scale(0.9)
        opacity: 0
        pointer-events: none
    &:active
      transform: scale(0.92)

@media (min-width: 768px)
    .back-to-top-btn
        right: 2rem
        bottom: 2rem

</style>

<script>
const setupBackToTop = () => {
    const button = document.getElementById("back-to-top-btn");
    if (!(button instanceof HTMLButtonElement) || button.dataset.ready === "true") return;

    button.dataset.ready = "true";
    button.addEventListener("click", () => {
        const behavior: ScrollBehavior = window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "auto"
            : "smooth";

        window.scrollTo({ top: 0, left: 0, behavior });
        document.scrollingElement?.scrollTo({ top: 0, left: 0, behavior });
    });
};

setupBackToTop();
</script>
