---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import { url } from "../../utils/url-utils";

interface Props {
	class?: string;
	headings: MarkdownHeading[];
}

let { headings = [] } = Astro.props;

let minDepth = 10;
for (const heading of headings) {
	minDepth = Math.min(minDepth, heading.depth);
}

const className = Astro.props.class;
const isPostsRoute = Astro.url.pathname.startsWith(url("/posts/"));

const removeTailingHash = (text: string) => {
	let lastIndexOfHash = text.lastIndexOf("#");
	if (lastIndexOfHash !== text.length - 1) {
		return text;
	}

	return text.substring(0, lastIndexOfHash);
};

let heading1Count = 1;

const maxLevel = siteConfig.toc.depth;
const visibleHeadings = headings.filter(
	(heading) => heading.depth >= minDepth && heading.depth < minDepth + maxLevel,
);
---
{isPostsRoute && visibleHeadings.length > 0 &&
<table-of-contents class:list={[className, "block py-2"]}>
    <div class="px-3 pb-2 text-xs font-bold tracking-[0.12em] text-black/35 dark:text-white/35">本页目录</div>
    {visibleHeadings.map((heading) => {
        const level = heading.depth - minDepth;
        return (
            <a href={`#${heading.slug}`} data-heading-slug={heading.slug}
               style={`--toc-level: ${level}`}
               class="toc-link flex items-start gap-2 relative w-full min-h-9 rounded-lg py-2 pr-2 hover:bg-[var(--toc-btn-hover)] active:bg-[var(--toc-btn-active)]">
                <span class:list={["toc-marker mt-[0.42rem] shrink-0 rounded-full transition-all", {
                    "w-4 h-4 -mt-px flex items-center justify-center text-[0.625rem] font-bold bg-[var(--toc-badge-bg)] text-[var(--btn-content)]": level === 0,
                    "w-2 h-2 bg-[var(--toc-badge-bg)]": level === 1,
                    "w-1.5 h-1.5 bg-black/15 dark:bg-white/20": level >= 2,
                }]}> {level === 0 && heading1Count++} </span>
                <span class="toc-title text-black/50 dark:text-white/50 leading-snug">{removeTailingHash(heading.text)}</span>
            </a>
        );
    })}
</table-of-contents>}

<style>
    .toc-link {
        padding-left: calc(0.5rem + var(--toc-level) * 0.7rem);
        transition: padding 180ms ease, background-color 180ms ease;
    }

    .toc-title {
        font-size: 0.8125rem;
        transition: color 180ms ease, font-size 180ms ease, font-weight 180ms ease, transform 180ms ease;
    }

    .toc-link.active {
        background: var(--toc-btn-hover);
    }

    .toc-link.active .toc-title {
        color: var(--primary);
        font-size: 1rem;
        font-weight: 700;
        transform: translateX(0.125rem);
    }

    .toc-link.active .toc-marker {
        transform: scale(1.18);
        background: var(--primary);
    }
</style>

<script>
class TableOfContents extends HTMLElement {
    tocEl: HTMLElement | null = null;
    observer: IntersectionObserver | null = null;
    headings: HTMLElement[] = [];
    tocEntries: HTMLAnchorElement[] = [];
    activeIndex = -1;
    animationFrame = 0;

    scheduleUpdate = () => {
        if (this.animationFrame) return;
        this.animationFrame = window.requestAnimationFrame(() => {
            this.animationFrame = 0;
            this.updateActiveHeading();
        });
    };

    updateActiveHeading = () => {
        if (this.headings.length === 0) return;
        const readingLine = Math.max(96, window.innerHeight * 0.18);
        let nextIndex = 0;
        for (let index = 0; index < this.headings.length; index++) {
            if (this.headings[index].getBoundingClientRect().top <= readingLine) {
                nextIndex = index;
            } else {
                break;
            }
        }
        const reachedBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
        if (reachedBottom) nextIndex = this.headings.length - 1;
        this.setActiveHeading(nextIndex);
    };

    setActiveHeading(index: number) {
        if (index === this.activeIndex) return;
        this.activeIndex = index;
        this.tocEntries.forEach((entry, entryIndex) => {
            const active = entryIndex === index;
            entry.classList.toggle("active", active);
            if (active) entry.setAttribute("aria-current", "location");
            else entry.removeAttribute("aria-current");
        });

        const activeEntry = this.tocEntries[index];
        if (!this.tocEl || !activeEntry) return;
        const entryTop = activeEntry.offsetTop;
        const entryBottom = entryTop + activeEntry.offsetHeight;
        const visibleTop = this.tocEl.scrollTop + 24;
        const visibleBottom = this.tocEl.scrollTop + this.tocEl.clientHeight - 24;
        if (entryTop < visibleTop || entryBottom > visibleBottom) {
            this.tocEl.scrollTo({
                top: Math.max(0, entryTop - this.tocEl.clientHeight * 0.35),
                behavior: "smooth",
            });
        }
    }

    handleAnchorClick = (event: Event) => {
        const anchor = (event.target as Element | null)?.closest<HTMLAnchorElement>("a[data-heading-slug]");
        if (!anchor) return;
        const index = this.tocEntries.indexOf(anchor);
        if (index >= 0) this.setActiveHeading(index);
		this.closest("details")?.removeAttribute("open");
    };

    connectedCallback() {
        requestAnimationFrame(() => this.init());
    };

    init() {
        this.cleanup();
        this.tocEl = this.closest<HTMLElement>(".toc-scroll-container");

        if (!this.tocEl) return;

        const pairs = Array.from(this.querySelectorAll<HTMLAnchorElement>("a[data-heading-slug]"))
            .map((entry) => ({
                entry,
                heading: document.getElementById(entry.dataset.headingSlug || ""),
            }))
            .filter((pair): pair is { entry: HTMLAnchorElement; heading: HTMLElement } => pair.heading instanceof HTMLElement);
        this.tocEntries = pairs.map((pair) => pair.entry);
        this.headings = pairs.map((pair) => pair.heading);
        if (this.tocEntries.length === 0) return;

        this.addEventListener("click", this.handleAnchorClick);
        window.addEventListener("scroll", this.scheduleUpdate, { passive: true });
        window.addEventListener("resize", this.scheduleUpdate, { passive: true });
        this.observer = new IntersectionObserver(this.scheduleUpdate, {
            rootMargin: "-15% 0px -75% 0px",
            threshold: [0, 1],
        });
        this.headings.forEach((heading) => this.observer?.observe(heading));
        this.updateActiveHeading();
    };

    disconnectedCallback() {
        this.cleanup();
    };

    cleanup() {
        this.observer?.disconnect();
        this.observer = null;
        this.removeEventListener("click", this.handleAnchorClick);
        window.removeEventListener("scroll", this.scheduleUpdate);
        window.removeEventListener("resize", this.scheduleUpdate);
        if (this.animationFrame) window.cancelAnimationFrame(this.animationFrame);
        this.animationFrame = 0;
    }
}

if (!customElements.get("table-of-contents")) {
    customElements.define("table-of-contents", TableOfContents);
}
</script>
