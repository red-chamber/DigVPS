---
interface Props {
	noteKey: string;
}

const { noteKey } = Astro.props;
---

<section class="note-interactions card-base mb-4 px-6 py-6 md:px-9 md:py-7" data-note-key={noteKey}>
	<div class="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--line-divider)] pb-4">
		<div>
			<h2 class="font-serif text-2xl font-bold text-black/85">Interactions</h2>
			<p class="mt-1 text-sm text-black/50">Only signed-in users can like notes and submit comments</p>
		</div>
		<button type="button" disabled class="note-like-button btn-regular rounded-full px-4 py-2 font-bold disabled:cursor-default" aria-pressed="false">
			<span class="note-like-label">Like</span>
			<span class="note-like-count ml-1 text-black/45">0</span>
		</button>
	</div>

	<p class="note-interaction-message mt-4 hidden rounded-lg px-4 py-3 text-sm" role="status"></p>
	<p class="note-guest-prompt mt-4 hidden text-sm text-black/60">You are browsing as a guest. <a href="/login/" data-no-swup class="note-sign-in font-bold text-[var(--primary)] underline">Sign in</a> to like or comment.</p>

	<form class="note-comment-form mt-5 hidden">
		<label class="mb-2 block font-bold text-black/75" for={`note-comment-${noteKey.replaceAll(/[^a-z0-9]/giu, "-")}`}>Leave a Comment</label>
		<textarea
			id={`note-comment-${noteKey.replaceAll(/[^a-z0-9]/giu, "-")}`}
			class="note-comment-input min-h-28 w-full rounded-xl border border-[var(--line-color)] bg-white/60 px-4 py-3 text-black/75 outline-none transition focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/20"
			required
			placeholder="Your comment will appear after administrator approval"
		></textarea>
		<div class="mt-2 flex items-center justify-between gap-3 text-sm text-black/45">
			<span>Up to 4 submissions every 24 hours</span>
			<span><span class="note-comment-count">0</span>/500</span>
		</div>
		<button type="submit" class="note-comment-submit btn-regular mt-3 rounded-lg px-5 py-2.5 font-bold">Submit for Review</button>
	</form>

	<div class="mt-7">
		<h3 class="font-bold text-black/75">Approved Comments</h3>
		<div class="note-comments mt-3 space-y-3">
			<p class="note-comments-loading text-sm text-black/45">Loading comments…</p>
		</div>
	</div>
</section>
